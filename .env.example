# Copy these keys into Railway/Render environment variables or your local shell.
# Do not commit real secrets, database passwords, JWT secrets, SMS credentials, or production URLs.

SPRING_PROFILES_ACTIVE=prod
PORT=8080
DB_URL=jdbc:mysql://host:3306/glowbook
DB_USERNAME=glowbook_user
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_DAYS=30
CORS_ALLOWED_ORIGINS=https://your-flutter-web-domain.example
REMINDER_CRON=0 0 10 * * *

# SMS provider values are optional until a real SMS sender is configured.
SMS_PROVIDER=disabled
SMS_API_KEY=replace-only-in-platform-secrets
SMS_API_SECRET=replace-only-in-platform-secrets
