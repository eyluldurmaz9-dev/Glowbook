# Copy these keys into Railway/Render environment variables or your local shell.
# Do not commit real secrets, database passwords, JWT secrets, SMS credentials, or production URLs.

SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Railway MySQL provides these automatically when the database service is attached.
MYSQLHOST=mysql.railway.internal
MYSQLPORT=3306
MYSQLDATABASE=railway
MYSQLUSER=root
MYSQLPASSWORD=change-me

# Optional aliases. If set, these override the Railway MYSQL* variables.
DB_URL=jdbc:mysql://mysql.railway.internal:3306/railway?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
HIBERNATE_DDL_AUTO=update
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=1

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_DAYS=30
CORS_ALLOWED_ORIGINS=https://*.vercel.app
REMINDER_CRON=0 0 10 * * *

# Opt-in test accounts. Leave disabled in normal production operation.
ENABLE_DEMO_USERS=false
DEMO_ADMIN_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=
DEMO_CUSTOMER_PASSWORD=

# SMS provider values are optional until a real SMS sender is configured.
SMS_PROVIDER=disabled
SMS_API_KEY=replace-only-in-platform-secrets
SMS_API_SECRET=replace-only-in-platform-secrets
